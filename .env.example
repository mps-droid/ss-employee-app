# Copy this file to .env and fill in the values. .env is git-ignored.
# react-native-config reads these at build time, so rebuild the app
# (not just reload Metro) after changing them.

# Base URL of the Social Sanitation API, without a trailing slash.
# Production: https://node.socialsanitation.com/api/v1
# Use a staging server while testing, so test data stays out of production.
API_BASE_URL=

# Firebase is configured from the native files, which are also kept out of git.
# Download them from Firebase console > Project settings and place them at:
#   android/app/google-services.json
#   ios/GoogleService-Info.plist
