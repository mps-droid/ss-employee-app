# Copy this file to .env and fill in the values. .env is git-ignored.
# react-native-config reads these at build time, so rebuild the app
# (not just reload Metro) after changing them.

# Google Maps SDK key for Android, used in AndroidManifest.xml.
# Restrict it in Google Cloud to package com.socialemployee plus the
# Play app-signing and upload SHA-1 fingerprints.
GOOGLE_MAPS_API_KEY_ANDROID=

# Google Maps SDK key for iOS, used in AppDelegate.mm once the GoogleMaps
# pod is installed. Restrict it to bundle ID com.sanitationEmployee.
GOOGLE_MAPS_API_KEY_IOS=

# Key used from JavaScript for the Directions API (src/screen/MapScreen/Map.js).
GOOGLE_DIRECTIONS_API_KEY=

# Firebase web app config used by src/utils/firebase.js.
# Firebase console > Project settings > General > Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# The native Firebase config files are also kept out of git. Download them
# from Firebase console > Project settings and place them at:
#   android/app/google-services.json
#   ios/GoogleService-Info.plist
